# ==============================================================================
# REPLOYTY — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# IMPORTANT:
# - NEVER commit sensitive credentials, keys, or passwords to version control.
# - In production, populate these via your secure secret manager or CI/CD vault.
# ==============================================================================

# Node Environment ('development' | 'staging' | 'production' | 'test')
NODE_ENV=production

# Server Port
PORT=3000

# Base Canonical Application URL (e.g. https://app.reployty.com)
APP_URL=https://app.reployty.com

# PostgreSQL Connection String (Primary Database)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public&sslmode=require&connection_limit=20
DATABASE_URL=postgresql://user:password@localhost:5432/reployty?schema=public

# Optional Dedicated Direct Database Connection String (for Prisma migrations if using PgBouncer/Supabase pooler)
DIRECT_DATABASE_URL=

# Test Database Connection String (Used exclusively during test runs)
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/reployty_test?schema=public

# Redis Connection URL (Distributed rate limiting, locks, and cache)
# Format: redis://[:password@]host[:port][/db-number] or rediss:// for TLS
REDIS_URL=redis://localhost:6379

# Session Secret (Cryptographically random string of >= 32 characters)
SESSION_SECRET=

# Customer PWA Session Secret (Cryptographically random string of >= 32 characters)
CUSTOMER_SESSION_SECRET=

# Allowed CORS Origins (Comma-separated exact origins, NO wildcards for authenticated requests)
# Example: https://app.reployty.com,https://admin.reployty.com
ALLOWED_ORIGINS=https://app.reployty.com

# Billing Webhook Secret (Matches signature/secret configured in payment provider webhook settings)
BILLING_WEBHOOK_SECRET=

# Simulated / Live Payment Provider Mode ('simulated' | 'stripe' | 'razorpay')
PAYMENT_PROVIDER=simulated

# SMS / OTP Delivery Provider Mode ('simulation' | 'twilio' | 'msg91')
# In 'simulation' mode, OTPs are safely logged to console in dev/test, NEVER exposed externally.
OTP_PROVIDER=simulation

# Error Monitoring (e.g., Sentry DSN, Datadog - leave blank if not configured)
SENTRY_DSN=

# Production Database Seed Protection ('true' allows explicit initial bootstrap of system roles/plans only)
ALLOW_PRODUCTION_BOOTSTRAP=false
