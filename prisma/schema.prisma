// Reployty Production Multi-Tenant Prisma Schema
// Provider: PostgreSQL
// Source of Truth for Data Architecture (Prompt 2)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum BusinessCategory {
  CAFE
  RESTAURANT
  BAKERY
  SALON
  BEAUTY
  SPA
  GYM
  GAMEZONE
  RETAIL
  OTHER
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  PENDING
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  VIP
  AT_RISK
  BLOCKED
}

enum ConsentChannel {
  MARKETING
  WHATSAPP
  SMS
  EMAIL
  NOTIFICATIONS
}

enum CustomerEventType {
  CUSTOMER_JOINED
  VISIT_RECORDED
  PURCHASE_RECORDED
  STAMP_ADDED
  POINTS_ADDED
  REWARD_EARNED
  REWARD_REDEEMED
  OFFER_REDEEMED
  REVIEW_REQUESTED
  REVIEW_GENERATED
  CUSTOMER_BECAME_VIP
  CUSTOMER_BECAME_AT_RISK
  CUSTOMER_BECAME_INACTIVE
  CUSTOMER_REACTIVATED
  CAMPAIGN_TOUCHPOINT
  CUSTOMER_BIRTHDAY
}

enum RetentionWorkflowType {
  INACTIVITY
  WIN_BACK
  BIRTHDAY
}

enum LoyaltyType {
  STAMP
  POINTS
  MILESTONE
  PRODUCT_REWARD
}

enum ProgramStatus {
  ACTIVE
  PAUSED
  DRAFT
  ARCHIVED
}

enum SegmentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SegmentType {
  DYNAMIC
  STATIC
}

enum CardStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum LoyaltyTransactionType {
  STAMP_ADDED
  STAMP_REMOVED
  POINTS_EARNED
  POINTS_REVERSED
  MILESTONE_REACHED
  ADJUSTMENT
  STAMP_REDEEMED
  POINTS_REDEEMED
}

enum RewardStatus {
  ACTIVE
  INACTIVE
  DRAFT
  ARCHIVED
}

enum RedemptionStatus {
  AVAILABLE
  CLAIMED
  REDEEMED
  EXPIRED
  CANCELLED
}

enum OfferType {
  PERCENTAGE_DISCOUNT
  FIXED_DISCOUNT
  FREE_PRODUCT
  FREE_SERVICE
  BUY_X_GET_Y
  BIRTHDAY
  COMEBACK
  VIP
  MILESTONE
}

enum OfferStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  DRAFT
}

enum GenerationStatus {
  DRAFT
  SELECTED
  COPIED_TO_GOOGLE
  ABANDONED
}

enum QRType {
  BUSINESS_STAND
  BRANCH_COUNTER
  LOYALTY_JOIN
  CAMPAIGN_PROMO
}

enum QRStatus {
  ACTIVE
  INACTIVE
}

enum CampaignChannel {
  WHATSAPP
  SMS
  EMAIL
  IN_APP
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  QUEUED
  PROCESSING
  SENDING
  SENT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum DeliveryStatus {
  PENDING
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  RETRY_WAIT
  FAILED
  CANCELLED
  EXPIRED
  OPENED
  CLICKED
  REDEEMED
}

enum CampaignType {
  ONE_TIME
  AUTOMATED
  TRIGGERED
}

enum AudienceType {
  ALL_CUSTOMERS
  SAVED_SEGMENT
  DYNAMIC_SEGMENT
  SPECIFIC_CUSTOMER
}

enum CampaignActionType {
  SEND_MESSAGE
  SEND_OFFER
  SEND_REWARD_REMINDER
  ADD_TAG
  REMOVE_TAG
  CREATE_TASK
}

enum AutomationActionType {
  SEND_CAMPAIGN
  AWARD_STAMPS
  ADD_TAG
  ASSIGN_OFFER
}

enum RuleStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ExecutionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
  CANCELLED
  SUCCESS
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAYMENT_FAILED
  GRACE_PERIOD
  OVERDUE
  SUSPENDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  PAID
  OPEN
  VOID
  UNCOLLECTIBLE
}

enum UsageMeterType {
  SMS_MESSAGE
  WHATSAPP_MESSAGE
  EMAIL_MESSAGE
  CAMPAIGN_DELIVERY
  AUTOMATION_EXECUTION
}

enum NotificationType {
  CUSTOMER_ALERT
  BUSINESS_ALERT
  REWARD_READY
  OFFER_EXPIRING
  BILLING_ISSUE
  SYSTEM
}

// ============================================================================
// 1. PLATFORM / IDENTITY / MULTI-TENANCY
// ============================================================================

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String
  phone        String?
  avatarUrl    String?
  passwordHash String     @default("")
  status       UserStatus @default(ACTIVE)
  isSuperAdmin Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships         StaffMembership[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  authoredNotes       CustomerNote[]
  rewardRedemptions   RewardRedemption[]
  offerRedemptions    OfferRedemption[]
  auditLogs           AuditLog[]
  createdCampaigns    Campaign[]            @relation("CampaignCreator")
  createdSegments     CustomerSegment[]     @relation("SegmentCreator")
  reviewedOnboardingRequests BusinessOnboardingRequest[] @relation("RequestReviewer")
  ownerInvitations           OwnerInvitation[]

  @@map("users")
}

model Business {
  id                  String           @id @default(uuid())
  name                String
  slug                String           @unique
  category            BusinessCategory @default(CAFE)
  description         String?
  logo                String?
  coverImage          String?
  primaryColor        String           @default("#4F6BFF")
  secondaryColor      String           @default("#111827")
  themePreset         String           @default("CAFE")
  timezone            String           @default("UTC")
  currency            String           @default("INR")
  phone               String?
  email               String?
  address             String?
  city                String?
  state               String?
  country             String?          @default("IN")
  postalCode          String?
  website             String?
  googleReviewUrl     String?
  instagramUrl        String?
  facebookUrl         String?
  whatsappNumber      String?
  status              BusinessStatus   @default(ACTIVE)
  planId              String?
  onboardingCompleted Boolean          @default(false)
  onboardingStep      Int              @default(1)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  branches            Branch[]
  staff               StaffMembership[]
  sessions            Session[]
  customers           Customer[]
  loyaltyPrograms     LoyaltyProgram[]
  rewards             Reward[]
  rewardRedemptions   RewardRedemption[]
  offers              Offer[]
  menus               Menu[]
  serviceCategories   ServiceCategory[]
  productCategories   ProductCategory[]
  reviewFeedbacks     ReviewFeedback[]
  qrCodes             QRCode[]
  customerSessions    CustomerSession[]
  otpChallenges       CustomerOtpChallenge[]
  campaigns           Campaign[]
  campaignExecutions  CampaignExecution[]
  campaignDeliveries  CampaignDelivery[]
  automationRules     AutomationRule[]
  automationExecutions AutomationExecution[]
  subscription        Subscription?
  auditLogs           AuditLog[]
  analyticsEvents     AnalyticsEvent[]
  customerEvents      CustomerEvent[]
  loyaltyTransactions LoyaltyTransaction[]
  customerTags        CustomerTag[]
  customerNotes       CustomerNote[]
  customerSegments    CustomerSegment[]
  payments            Payment[]
  invoices            Invoice[]
  messagingConfigs    BusinessMessagingConfig[]
  providerDeliveryEvents ProviderDeliveryEvent[]
  campaignAnalyticsEvents CampaignAnalyticsEvent[]
  campaignTrackingLinks   CampaignTrackingLink[]
  campaignConversions     CampaignConversion[]
  automationRuleVersions  AutomationRuleVersion[]
  usageMeterEvents        UsageMeterEvent[]
  onboardingRequests      BusinessOnboardingRequest[] @relation("ProvisionedFromRequest")
  ownerInvitations        OwnerInvitation[]

  @@map("businesses")
}

model Branch {
  id           String       @id @default(uuid())
  businessId   String
  name         String
  code         String?
  address      String?
  city         String?
  state        String?
  country      String?      @default("IN")
  postalCode   String?
  phone        String?
  timezone     String       @default("UTC")
  status       BranchStatus @default(ACTIVE)
  isMainBranch Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  business           Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff              StaffMembership[]
  customers          Customer[]
  qrCodes            QRCode[]
  transactions       LoyaltyTransaction[]
  rewards            Reward[]
  rewardRedemptions  RewardRedemption[]
  reviewFeedbacks    ReviewFeedback[]
  campaigns          Campaign[]
  campaignExecutions CampaignExecution[]
  campaignDeliveries CampaignDelivery[]
  customerSegments   CustomerSegment[]
  automationRules    AutomationRule[]
  automationExecutions AutomationExecution[]
  customerEvents     CustomerEvent[]

  @@index([businessId, status])
  @@map("branches")
}

model StaffMembership {
  id         String           @id @default(uuid())
  userId     String
  businessId String
  branchId   String?
  roleId     String
  status     MembershipStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  role     Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, businessId])
  @@index([businessId, status])
  @@map("staff_memberships")
}

model Role {
  id          String   @id @default(uuid())
  businessId  String?  // null for global/system default roles (Owner, Manager, Staff)
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships     StaffMembership[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  category    String
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================================
// 2. CUSTOMER CRM & ACTIVITY
// ============================================================================

model Customer {
  id               String         @id @default(uuid())
  businessId       String
  branchId         String?
  name             String
  phone            String
  email            String?
  birthday         DateTime?
  joinedAt         DateTime       @default(now())
  lastVisitAt      DateTime?
  status           CustomerStatus @default(ACTIVE)
  marketingConsent Boolean        @default(false)
  totalVisits      Int            @default(0)
  totalSpendMinor  Int            @default(0) // Integer minor units (e.g., paisa / cents)
  stampsBalance    Int            @default(0)
  pointsBalance    Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  business          Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch            Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  consents          CustomerConsent[]
  tags              CustomerTagAssignment[]
  notes             CustomerNote[]
  events            CustomerEvent[]
  loyaltyCards      LoyaltyCard[]
  transactions      LoyaltyTransaction[]
  rewardRedemptions RewardRedemption[]
  offerRedemptions  OfferRedemption[]
  reviewFeedbacks   ReviewFeedback[]
  sessions          CustomerSession[]
  campaignDeliveries CampaignDelivery[]
  automationExecutions AutomationExecution[]
  campaignAnalyticsEvents CampaignAnalyticsEvent[]
  campaignConversions     CampaignConversion[]
  usageMeterEvents        UsageMeterEvent[]

  // Critical Invariant: Phone uniqueness is scoped to the business!
  @@unique([businessId, phone])
  @@index([businessId, status])
  @@index([businessId, lastVisitAt])
  @@index([businessId, birthday])
  @@index([businessId, email])
  @@map("customers")
}

model CustomerConsent {
  id         String         @id @default(uuid())
  customerId String
  channel    ConsentChannel
  granted    Boolean
  source     String
  version    String         @default("1.0")
  ipAddress  String?
  grantedAt  DateTime       @default(now())
  revokedAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, channel])
  @@map("customer_consents")
}

model CustomerTag {
  id         String   @id @default(uuid())
  businessId String
  name       String
  color      String   @default("#4F6BFF")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business    Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assignments CustomerTagAssignment[]

  @@unique([businessId, name])
  @@map("customer_tags")
}

model CustomerTagAssignment {
  id         String   @id @default(uuid())
  customerId String
  tagId      String
  createdAt  DateTime @default(now())

  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([customerId, tagId])
  @@map("customer_tag_assignments")
}

model CustomerNote {
  id         String   @id @default(uuid())
  businessId String?
  customerId String
  authorId   String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, customerId])
  @@index([customerId])
  @@map("customer_notes")
}

model CustomerSegment {
  id             String        @id @default(uuid())
  businessId     String
  branchId       String?
  name           String
  description    String?
  type           SegmentType   @default(DYNAMIC)
  ruleDefinition Json
  status         SegmentStatus @default(ACTIVE)
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy User?      @relation("SegmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  campaigns Campaign[]

  @@index([businessId, status])
  @@index([businessId, type])
  @@index([branchId])
  @@map("customer_segments")
}

model CustomerEvent {
  id         String            @id @default(uuid())
  businessId String
  customerId String
  branchId   String?
  type       CustomerEventType
  metadata   Json?
  createdAt  DateTime          @default(now())

  business   Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branch     Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  executions AutomationExecution[]

  @@index([businessId, createdAt])
  @@index([businessId, type, createdAt])
  @@index([customerId, createdAt])
  @@index([branchId])
  @@map("customer_events")
}

// ============================================================================
// 3. LOYALTY ENGINE
// ============================================================================

model LoyaltyProgram {
  id                     String        @id @default(uuid())
  businessId             String
  name                   String
  type                   LoyaltyType   @default(STAMP)
  status                 ProgramStatus @default(ACTIVE)
  targetStamps           Int?          @default(10)
  pointsPerCurrencyMinor Int?          // E.g. 1 point per 100 minor units (100 paisa = 1 INR)
  rewardTitle            String
  rulesConfig            Json?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cards    LoyaltyCard[]
  rewards  Reward[]

  @@index([businessId, status])
  @@map("loyalty_programs")
}

model LoyaltyCard {
  id                 String     @id @default(uuid())
  businessId         String
  customerId         String
  programId          String
  stampsCollected    Int        @default(0)
  totalStampsNeeded  Int        @default(10)
  pointsBalance      Int        @default(0)
  status             CardStatus @default(ACTIVE)
  issuedAt           DateTime   @default(now())
  completedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  program      LoyaltyProgram       @relation(fields: [programId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]
  rewardRedemptions RewardRedemption[]

  @@unique([customerId, programId])
  @@index([businessId, customerId])
  @@map("loyalty_cards")
}

model LoyaltyTransaction {
  id              String                 @id @default(uuid())
  businessId      String
  branchId        String?
  customerId      String
  cardId          String?
  type            LoyaltyTransactionType
  deltaStamps     Int                    @default(0)
  deltaPoints     Int                    @default(0)
  referenceType   String?
  referenceId     String?
  idempotencyKey  String?
  metadata        Json?
  createdByUserId String?
  createdAt       DateTime               @default(now())

  business Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  card     LoyaltyCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@unique([businessId, idempotencyKey])
  @@index([businessId, customerId])
  @@index([businessId, createdAt])
  @@map("loyalty_transactions")
}

// ============================================================================
// 4. REWARDS & REDEMPTIONS
// ============================================================================

model Reward {
  id                    String       @id @default(uuid())
  businessId            String
  title                 String
  description           String?
  stampsRequired        Int?
  pointsRequired        Int?
  status                RewardStatus @default(ACTIVE)
  expiryDays            Int?         @default(30)
  usageLimitTotal       Int?
  usageLimitPerCustomer Int?         @default(1)
  branchId              String?
  programId             String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  program     LoyaltyProgram?    @relation(fields: [programId], references: [id], onDelete: SetNull)
  redemptions RewardRedemption[]

  @@index([businessId, status])
  @@index([businessId, branchId])
  @@map("rewards")
}

model RewardRedemption {
  id                 String           @id @default(uuid())
  businessId         String
  branchId           String?
  rewardId           String
  customerId         String
  loyaltyCardId      String?
  redeemedByUserId   String?
  redemptionCode     String           @unique
  status             RedemptionStatus @default(CLAIMED)
  stampsConsumed     Int?             @default(0)
  pointsConsumed     Int?             @default(0)
  idempotencyKey     String?
  claimedAt          DateTime         @default(now())
  redeemedAt         DateTime?
  expiresAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  reward      Reward       @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  loyaltyCard LoyaltyCard? @relation(fields: [loyaltyCardId], references: [id], onDelete: SetNull)
  redeemedBy  User?        @relation(fields: [redeemedByUserId], references: [id], onDelete: SetNull)

  @@unique([businessId, idempotencyKey])
  @@index([businessId, customerId])
  @@index([businessId, status])
  @@index([businessId, redemptionCode])
  @@map("reward_redemptions")
}

// ============================================================================
// 5. OFFERS & PROMOTIONS
// ============================================================================

model Offer {
  id                    String      @id @default(uuid())
  businessId            String
  title                 String
  description           String?
  type                  OfferType   @default(PERCENTAGE_DISCOUNT)
  discountValue         Int         @default(0) // Percentage or minor currency amount
  minPurchaseMinor      Int?
  maxDiscountMinor      Int?
  startDate             DateTime    @default(now())
  endDate               DateTime?
  usageLimitTotal       Int?
  usageLimitPerCustomer Int?        @default(1)
  status                OfferStatus @default(ACTIVE)
  eligibilityConfig     Json?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  redemptions OfferRedemption[]
  campaigns   Campaign[]

  @@index([businessId, status])
  @@map("offers")
}

model OfferRedemption {
  id               String           @id @default(uuid())
  businessId       String
  branchId         String?
  offerId          String
  customerId       String
  redeemedByUserId String?
  status           RedemptionStatus @default(REDEEMED)
  redemptionCode   String?          @unique
  idempotencyKey   String?
  redeemedAt       DateTime         @default(now())
  createdAt        DateTime         @default(now())

  offer      Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  redeemedBy User?    @relation(fields: [redeemedByUserId], references: [id], onDelete: SetNull)

  @@unique([businessId, idempotencyKey])
  @@index([businessId, customerId])
  @@index([businessId, offerId])
  @@map("offer_redemptions")
}

// ============================================================================
// 6. BUSINESS CATALOG (MENU, SERVICES, PRODUCTS)
// ============================================================================

model Menu {
  id         String   @id @default(uuid())
  businessId String
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categories MenuCategory[]

  @@map("menus")
}

model MenuCategory {
  id        String     @id @default(uuid())
  menuId    String
  name      String
  sortOrder Int        @default(0)
  menu      Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items     MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id          String       @id @default(uuid())
  categoryId  String
  name        String
  description String?
  priceMinor  Int          // In minor integer units (paisa / cents)
  isAvailable Boolean      @default(true)
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("menu_items")
}

model ServiceCategory {
  id         String    @id @default(uuid())
  businessId String
  name       String
  sortOrder  Int       @default(0)
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services   Service[]

  @@map("service_categories")
}

model Service {
  id              String          @id @default(uuid())
  categoryId      String
  name            String
  durationMinutes Int             @default(30)
  priceMinor      Int             // In minor integer units
  isAvailable     Boolean         @default(true)
  category        ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("services")
}

model ProductCategory {
  id         String    @id @default(uuid())
  businessId String
  name       String
  sortOrder  Int       @default(0)
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products   Product[]

  @@map("product_categories")
}

model Product {
  id            String          @id @default(uuid())
  categoryId    String
  name          String
  sku           String?
  priceMinor    Int             // In minor integer units
  stockQuantity Int             @default(0)
  isAvailable   Boolean         @default(true)
  category      ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("products")
}

// ============================================================================
// 7. REVIEW SYSTEM & AI ASSISTANT DRAFTS
// ============================================================================

model ReviewFeedback {
  id                         String   @id @default(uuid())
  businessId                 String
  branchId                   String?
  customerId                 String
  rating                     Int      // 1 to 5
  feedbackText               String?
  sentiment                  String?
  isPublicGoogleReviewTarget Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer    Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  generations ReviewGeneration[]

  @@index([businessId, rating])
  @@map("review_feedbacks")
}

model ReviewGeneration {
  id               String           @id @default(uuid())
  feedbackId       String
  businessId       String
  generatedEnglish String
  generatedHinglish String
  generatedHindi   String
  selectedVersion  String?
  editedText       String?
  status           GenerationStatus @default(DRAFT)
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  feedback ReviewFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@map("review_generations")
}

// ============================================================================
// 8. QR CODE INFRASTRUCTURE
// ============================================================================

model QRCode {
  id             String   @id @default(uuid())
  businessId     String
  branchId       String?
  code           String   @unique
  type           QRType   @default(BUSINESS_STAND)
  destinationUrl String
  scanCount      Int      @default(0)
  status         QRStatus @default(ACTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([businessId, type])
  @@map("qr_codes")
}

// ============================================================================
// 9. CAMPAIGNS & RETENTION
// ============================================================================

model Campaign {
  id              String             @id @default(uuid())
  businessId      String
  offerId         String?
  name            String
  description     String?
  type            CampaignType       @default(ONE_TIME)
  audienceType    AudienceType       @default(ALL_CUSTOMERS)
  segmentId       String?
  branchId        String?
  createdById     String?
  actionType      CampaignActionType @default(SEND_MESSAGE)
  triggerEvent    CustomerEventType?
  triggerConfig   Json?
  audienceFilter  Json?
  channel         CampaignChannel    @default(WHATSAPP)
  messageTemplate String
  scheduledAt     DateTime?
  timezone        String?
  startDate       DateTime?
  endDate         DateTime?
  lastRunAt       DateTime?
  status          CampaignStatus     @default(DRAFT)
  totalAudience   Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  business        Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  offer           Offer?             @relation(fields: [offerId], references: [id], onDelete: SetNull)
  segment         CustomerSegment?   @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  branch          Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy       User?              @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deliveries      CampaignDelivery[]
  executions      CampaignExecution[]
  attributionWindowDays Int @default(14)
  analyticsEvents CampaignAnalyticsEvent[]
  trackingLinks   CampaignTrackingLink[]
  conversions     CampaignConversion[]
  usageMeterEvents UsageMeterEvent[]

  @@index([businessId, status])
  @@index([businessId, type])
  @@index([branchId])
  @@map("campaigns")
}

model CampaignExecution {
  id             String             @id @default(uuid())
  campaignId     String
  businessId     String
  branchId       String?
  triggerType    String             @default("SCHEDULED")
  status         String             @default("QUEUED")
  totalAudience  Int                @default(0)
  eligibleCount  Int                @default(0)
  queuedCount    Int                @default(0)
  deliveredCount Int                @default(0)
  failedCount    Int                @default(0)
  skippedCount   Int                @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  errorMessage   String?
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  campaign       Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch         Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  deliveries          CampaignDelivery[]
  automationExecutions AutomationExecution[]

  @@index([campaignId, createdAt])
  @@index([businessId, status])
  @@map("campaign_executions")
}

model CampaignDelivery {
  id             String             @id @default(uuid())
  campaignId     String
  customerId     String
  businessId     String?
  branchId       String?
  executionId    String?
  channel        CampaignChannel
  status         DeliveryStatus     @default(QUEUED)
  attemptCount   Int                @default(0)
  maxAttempts    Int                @default(5)
  availableAt    DateTime?          @default(now())
  scheduledAt    DateTime?
  lastAttemptAt  DateTime?
  nextRetryAt    DateTime?
  lockedAt       DateTime?
  lockedBy       String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  cancelledAt    DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  provider       String?
  providerMessageId String?
  failedReason   String?
  lastError      String?
  idempotencyKey String?            @unique
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt @default(now())

  campaign       Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  business       Business?          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch         Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  execution      CampaignExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)
  providerDeliveryEvents ProviderDeliveryEvent[]
  readAt         DateTime?
  analyticsEvents CampaignAnalyticsEvent[]
  trackingLinks   CampaignTrackingLink[]
  conversions     CampaignConversion[]
  usageMeterEvents UsageMeterEvent[]

  @@index([campaignId, status])
  @@index([customerId, createdAt])
  @@index([status, availableAt, nextRetryAt])
  @@index([businessId, status])
  @@index([executionId])
  @@index([providerMessageId])
  @@map("campaign_deliveries")
}

// ============================================================================
// 10. AUTOMATION RULES
// ============================================================================

model AutomationRule {
  id                       String               @id @default(uuid())
  businessId               String
  branchId                 String?
  name                     String
  description              String?
  triggerEvent             CustomerEventType
  conditionConfig          Json                 @default("{}")
  actionType               AutomationActionType @default(SEND_CAMPAIGN)
  actionConfig             Json                 @default("{}")
  status                   RuleStatus           @default(DRAFT)
  version                  Int                  @default(1)
  workflowDefinition       Json?
  draftDefinition          Json?
  workflowType             RetentionWorkflowType?
  retentionConfig          Json?
  cooldownMinutes          Int                  @default(0)
  maxExecutionsPerCustomer Int?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  business   Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch     Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  executions AutomationExecution[]
  versions   AutomationRuleVersion[]

  @@index([businessId, status])
  @@index([businessId, workflowType, status])
  @@index([businessId, triggerEvent, status])
  @@index([branchId])
  @@map("automation_rules")
}

model AutomationRuleVersion {
  id                 String               @id @default(uuid())
  ruleId             String
  businessId         String
  version            Int
  name               String
  triggerEvent       CustomerEventType
  workflowDefinition Json?
  conditionConfig    Json                 @default("{}")
  actionType         AutomationActionType @default(SEND_CAMPAIGN)
  actionConfig       Json                 @default("{}")
  createdAt          DateTime             @default(now())

  rule     AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([ruleId, version])
  @@index([businessId, ruleId])
  @@map("automation_rule_versions")
}

model AutomationExecution {
  id                  String            @id @default(uuid())
  ruleId              String
  businessId          String
  branchId            String?
  customerId          String
  eventId             String?
  campaignExecutionId String?
  triggerEvent        CustomerEventType
  ruleVersion         Int?              @default(1)
  status              ExecutionStatus   @default(PENDING)
  resultMetadata      Json?
  skipReason          String?
  lastError           String?
  attemptCount        Int               @default(1)
  idempotencyKey      String?           @unique
  startedAt           DateTime?
  completedAt         DateTime?
  failedAt            DateTime?
  executedAt          DateTime          @default(now())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  rule              AutomationRule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch            Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  event             CustomerEvent?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  campaignExecution CampaignExecution? @relation(fields: [campaignExecutionId], references: [id], onDelete: SetNull)

  @@unique([ruleId, eventId])
  @@index([businessId, status])
  @@index([ruleId, customerId, executedAt])
  @@index([eventId])
  @@index([customerId])
  @@map("automation_executions")
}

// ============================================================================
// 11. BILLING & SUBSCRIPTIONS
// ============================================================================

model Plan {
  id               String          @id @default(uuid())
  name             String
  slug             String          @unique
  description      String?
  priceMinor       Int
  yearlyPriceMinor Int?
  currency         String          @default("INR")
  billingInterval  BillingInterval @default(MONTHLY)
  features         Json?
  limits           Json?
  maxCustomers     Int             @default(1000)
  maxBranches      Int             @default(1)
  maxStaff         Int             @default(5)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  businessId         String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIAL)
  billingInterval    BillingInterval    @default(MONTHLY)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  trialEndsAt        DateTime?
  gracePeriodEndsAt  DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]
  invoices Invoice[]
  usageMeterEvents UsageMeterEvent[]

  @@map("subscriptions")
}

model Payment {
  id                String        @id @default(uuid())
  businessId        String
  subscriptionId    String?
  amountMinor       Int
  currency          String        @default("INR")
  status            PaymentStatus @default(SUCCESS)
  provider          String?
  providerPaymentId String?
  paymentMethod     String?
  createdAt         DateTime      @default(now())

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@map("payments")
}

model Invoice {
  id             String        @id @default(uuid())
  businessId     String
  subscriptionId String?
  invoiceNumber  String        @unique
  amountMinor    Int
  currency       String        @default("INR")
  status         InvoiceStatus @default(PAID)
  billingPeriod  String?
  pdfUrl         String?
  issuedAt       DateTime      @default(now())
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@map("invoices")
}

model UsageMeterEvent {
  id                    String            @id @default(uuid())
  businessId            String
  subscriptionId        String?
  billingPeriodStart    DateTime
  billingPeriodEnd      DateTime
  meterType             UsageMeterType
  quantity              Int               @default(1)
  sourceType            String
  sourceId              String
  channel               CampaignChannel?
  customerId            String?
  campaignId            String?
  campaignDeliveryId    String?
  automationExecutionId String?
  unitPriceMinor        Int?
  currency              String?           @default("INR")
  isOverage             Boolean           @default(false)
  idempotencyKey        String            @unique
  metadata              Json?
  occurredAt            DateTime          @default(now())
  createdAt             DateTime          @default(now())

  business              Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription          Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  campaign              Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignDelivery      CampaignDelivery? @relation(fields: [campaignDeliveryId], references: [id], onDelete: SetNull)
  customer              Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([businessId, occurredAt])
  @@index([businessId, meterType, occurredAt])
  @@index([businessId, subscriptionId, occurredAt])
  @@index([businessId, campaignId])
  @@map("usage_meter_events")
}

// ============================================================================
// 12. NOTIFICATIONS, AUDIT & ANALYTICS
// ============================================================================

model Notification {
  id         String           @id @default(uuid())
  businessId String?
  customerId String?
  userId     String?
  type       NotificationType @default(BUSINESS_ALERT)
  title      String
  body       String
  channel    String           @default("IN_APP")
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@map("notifications")
}

model AuditLog {
  id            String   @id @default(uuid())
  businessId    String?
  actorUserId   String?
  action        String
  entityType    String
  entityId      String
  previousState Json?
  newState      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor    User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  businessId String
  branchId   String?
  customerId String?
  eventType  String
  eventData  Json?
  timestamp  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, eventType, timestamp])
  @@map("analytics_events")
}

// ============================================================================
// 13. SESSIONS & AUTHENTICATION TOKENS
// ============================================================================

model Session {
  id           String    @id @default(uuid())
  sessionToken String    @unique
  userId       String
  businessId   String?   // Currently active tenant context
  expiresAt    DateTime
  revokedAt    DateTime?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([sessionToken])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash, expiresAt])
  @@map("password_reset_tokens")
}

// ============================================================================
// 14. CUSTOMER AUTHENTICATION & SESSIONS
// ============================================================================

model CustomerSession {
  id           String    @id @default(uuid())
  sessionToken String    @unique
  customerId   String
  businessId   String
  expiresAt    DateTime
  revokedAt    DateTime?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([customerId, expiresAt])
  @@index([businessId])
  @@index([sessionToken])
  @@map("customer_sessions")
}

model CustomerOtpChallenge {
  id          String    @id @default(uuid())
  businessId  String
  phone       String    // Normalized E.164 phone
  codeHash    String    // SHA-256 hashed 6-digit OTP code
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  consumedAt  DateTime?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([phone, businessId])
  @@index([expiresAt])
  @@map("customer_otp_challenges")
}

// ============================================================================
// 12. MESSAGING PROVIDER CONNECTORS (PHASE 25)
// ============================================================================

model BusinessMessagingConfig {
  id          String          @id @default(uuid())
  businessId  String
  channel     CampaignChannel
  provider    String          // 'MSG91' | 'META_WHATSAPP' | 'SENDGRID'
  isEnabled   Boolean         @default(true)
  credentials Json            // Encrypted / secured server-side API keys, tokens
  settings    Json?           // Non-secret settings: senderId, fromEmail, fromName, templateId, etc.
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt @default(now())

  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, channel])
  @@index([businessId, channel, isEnabled])
  @@map("business_messaging_configs")
}

model ProviderDeliveryEvent {
  id                String          @id @default(uuid())
  deliveryId        String?
  businessId        String?
  provider          String          // 'MSG91' | 'META_WHATSAPP' | 'SENDGRID'
  channel           CampaignChannel
  providerMessageId String
  eventType         String          // 'DELIVERED' | 'SENT' | 'FAILED' | 'BOUNCED' | 'READ'
  rawPayload        Json?
  idempotencyKey    String?         @unique
  createdAt         DateTime        @default(now())

  delivery          CampaignDelivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  business          Business?         @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([providerMessageId])
  @@index([businessId, providerMessageId])
  @@index([deliveryId])
  @@map("provider_delivery_events")
}

// ============================================================================
// 14. CAMPAIGN ANALYTICS, TRACKING & CONVERSION ATTRIBUTION (PHASE 26)
// ============================================================================

model CampaignAnalyticsEvent {
  id                  String             @id @default(uuid())
  businessId          String
  campaignId          String
  campaignExecutionId String?
  campaignDeliveryId  String?
  customerId          String?
  channel             CampaignChannel
  eventType           String             // 'SENT' | 'DELIVERED' | 'FAILED' | 'BOUNCED' | 'DROPPED' | 'OPENED' | 'CLICKED' | 'READ' | 'SPAM_REPORTED' | 'UNSUBSCRIBED' | 'CONVERTED'
  provider            String?            // 'MSG91' | 'META_WHATSAPP' | 'SENDGRID' | 'SYSTEM'
  providerEventId     String?
  idempotencyKey      String?            @unique
  metadata            Json?
  occurredAt          DateTime           @default(now())
  createdAt           DateTime           @default(now())

  business            Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign            Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignDelivery    CampaignDelivery?  @relation(fields: [campaignDeliveryId], references: [id], onDelete: SetNull)
  customer            Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([campaignId, eventType, occurredAt])
  @@index([businessId, eventType, occurredAt])
  @@index([campaignDeliveryId])
  @@index([customerId])
  @@index([providerEventId])
  @@map("campaign_analytics_events")
}

model CampaignTrackingLink {
  id               String               @id @default(uuid())
  businessId       String
  campaignId       String
  deliveryId       String?
  customerId       String?
  trackingCode     String               @unique
  originalUrl      String
  clickCount       Int                  @default(0)
  uniqueClickCount Int                  @default(0)
  lastClickedAt    DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt @default(now())

  business         Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign         Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  delivery         CampaignDelivery?    @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  clicks           CampaignClickEvent[]

  @@index([businessId, campaignId])
  @@index([deliveryId])
  @@map("campaign_tracking_links")
}

model CampaignClickEvent {
  id             String               @id @default(uuid())
  trackingLinkId String
  businessId     String
  campaignId     String
  deliveryId     String?
  customerId     String?
  ipAddress      String?
  userAgent      String?
  clickedAt      DateTime             @default(now())

  trackingLink   CampaignTrackingLink @relation(fields: [trackingLinkId], references: [id], onDelete: Cascade)

  @@index([trackingLinkId, customerId])
  @@index([campaignId, clickedAt])
  @@index([businessId])
  @@map("campaign_click_events")
}

model CampaignConversion {
  id                    String            @id @default(uuid())
  businessId            String
  campaignId            String
  campaignDeliveryId    String
  customerId            String
  conversionType        String            // 'RETURN_VISIT' | 'LOYALTY_STAMP' | 'LOYALTY_POINTS' | 'REWARD_REDEMPTION' | 'OFFER_REDEMPTION' | 'CUSTOMER_REACTIVATED' | 'PURCHASE_RECORDED'
  sourceEventId         String?
  attributionWindowDays Int               @default(14)
  occurredAt            DateTime          @default(now())
  idempotencyKey        String            @unique
  metadata              Json?
  createdAt             DateTime          @default(now())

  business              Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign              Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  delivery              CampaignDelivery  @relation(fields: [campaignDeliveryId], references: [id], onDelete: Cascade)
  customer              Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId, campaignId, occurredAt])
  @@index([campaignDeliveryId])
  @@index([customerId])
  @@index([conversionType])
  @@map("campaign_conversions")
}

// ============================================================================
// 17. MANAGED BUSINESS PROVISIONING & CLIENT ONBOARDING
// ============================================================================

enum OnboardingRequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  PROVISIONED
}

model BusinessOnboardingRequest {
  id                    String                  @id @default(uuid())
  businessName          String
  businessCategory      BusinessCategory        @default(CAFE)
  businessDescription   String?
  ownerName             String
  ownerEmail            String
  ownerPhone            String
  country               String                  @default("IN")
  city                  String
  address               String
  state                 String?
  postalCode            String?
  website               String?
  businessPhone         String?
  estimatedBranches     Int                     @default(1)
  logoUrl               String?
  primaryColor          String?                 @default("#4F6BFF")
  themePreset           String?                 @default("modern")
  status                OnboardingRequestStatus @default(PENDING)
  notes                 String?
  rejectionReason       String?
  reviewedAt            DateTime?
  reviewedByUserId      String?
  provisionedAt         DateTime?
  provisionedBusinessId String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  reviewedBy            User?                   @relation("RequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  provisionedBusiness   Business?               @relation("ProvisionedFromRequest", fields: [provisionedBusinessId], references: [id], onDelete: SetNull)
  invitations           OwnerInvitation[]

  @@index([status, createdAt])
  @@index([ownerEmail])
  @@map("business_onboarding_requests")
}

model OwnerInvitation {
  id                    String                     @id @default(uuid())
  businessId            String
  userId                String
  onboardingRequestId   String?
  tokenHash             String                     @unique
  expiresAt             DateTime
  usedAt                DateTime?
  sentAt                DateTime?
  createdByUserId       String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  business              Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user                  User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboardingRequest     BusinessOnboardingRequest? @relation(fields: [onboardingRequestId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([tokenHash, expiresAt])
  @@map("owner_invitations")
}



